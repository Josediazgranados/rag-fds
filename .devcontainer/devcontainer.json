{
  "name": "RAG-FDS (CPU)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postStartCommand": "nohup ollama serve > /tmp/ollama.log 2>&1 &",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Demo RAG-FDS", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
